# Server-side only. Required for the AI assistant and AI shipping summaries.
GEMINI_API_KEY=
# Optional model override (defaults to gemini-3.1-flash-lite, same as the catalog pipeline).
GEMINI_MODEL=
# Parent pages allowed to talk to the app via postMessage (comma-separated origins).
NEXT_PUBLIC_BILLTRUST_ORIGINS=https://buyblazer.com,https://www.buyblazer.com
# CSP frame-ancestors value controlling who may embed the app.
FRAME_ANCESTORS='self' https://buyblazer.com https://*.buyblazer.com
# Optional absolute path to the catalog JSON (defaults to data/blazer_web_catalog.json).
CATALOG_PATH=
